%div.subcategory_list_element_container
  %div.tag_list_element_name_container
    %span
      = category.name
  %div.tag_list_element_actions_container
    %span
      = link_to fa_icon("edit"), edit_admin_category_path(category.id), class: "tag_edit_icon"
    %span
      = link_to fa_icon("trash"), admin_category_path(category.id), method: :delete, id: "category-#{category.id}-delete", data: { turbo: false, confirm: "Are you sure you want to delete the #{category.name} subcategory? It is associated with #{category.resource_count} services. This action cannot be undone." }, class: "tag_delete_icon"
  %div{style: "clear: both;"} 